{
  "name": "porverse-nextjs",
  "version": "1.0.0",
  "description": "PorVerse - AI-Powered Personal Transformation Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:system": "ts-node scripts/test-everything.ts",
    "update:components": "node scripts/update-dashboard-components.js",
    "setup": "./setup.sh",
    "launch": "./launch-porverse.sh",
    "launch:quick": "./launch-porverse.sh && npm run dev",
    "db:migrate": "supabase db reset --linked",
    "db:seed": "supabase db seed",
    "test:api": "jest --testPathPattern=api",
    "test:components": "jest --testPathPattern=components",
    "analyze": "cross-env ANALYZE=true next build",
    "postinstall": "chmod +x *.sh 2>/dev/null || true"
  },
  "dependencies": {
